{
  "info": {
    "name": "CampusCare API Collection",
    "description": "Postman API test suite for CampusCare Smart Campus Service & Issue Management Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@campuscare.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "http://localhost:8080/api/auth/login"
          }
        },
        {
          "name": "Login - Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student1@campuscare.com\",\n  \"password\": \"student123\"\n}"
            },
            "url": "http://localhost:8080/api/auth/login"
          }
        },
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Student\",\n  \"email\": \"newstudent@campuscare.com\",\n  \"password\": \"password123\",\n  \"department\": \"Computer Science\"\n}"
            },
            "url": "http://localhost:8080/api/auth/register"
          }
        },
        {
          "name": "Current User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:8080/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Issues",
      "item": [
        {
          "name": "Create Issue",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Wi-Fi not working in CSE Lab 2\",\n  \"description\": \"Students are unable to connect to campus Wi-Fi.\",\n  \"category\": \"WIFI_INTERNET\",\n  \"priority\": \"HIGH\",\n  \"location\": \"CSE Lab 2\"\n}"
            },
            "url": "http://localhost:8080/api/issues"
          }
        },
        {
          "name": "Get Issues with Filters",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:8080/api/issues?category=WIFI_INTERNET&priority=HIGH"
          }
        },
        {
          "name": "Get Issue Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:8080/api/issues/1"
          }
        },
        {
          "name": "Assign Staff (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"staffId\": 3,\n  \"note\": \"Inspect router firmware\"\n}"
            },
            "url": "http://localhost:8080/api/issues/1/assign"
          }
        },
        {
          "name": "Accept Issue (Staff)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{staff_token}}" }],
            "url": "http://localhost:8080/api/issues/1/accept"
          }
        },
        {
          "name": "Resolve Issue (Staff)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staff_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESOLVED\",\n  \"notes\": \"Replaced router cable and rebooted gateway switch.\"\n}"
            },
            "url": "http://localhost:8080/api/issues/1/status"
          }
        }
      ]
    },
    {
      "name": "Admin & Analytics",
      "item": [
        {
          "name": "Admin Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "http://localhost:8080/api/admin/dashboard"
          }
        },
        {
          "name": "Admin Recharts Analytics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "http://localhost:8080/api/admin/analytics"
          }
        }
      ]
    }
  ]
}
